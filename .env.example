# Neon (Postgres) connection string.
#
# Copy this file to `.env.local` for local development (`.env.local` is git-ignored).
# On Vercel, add DATABASE_URL under Project -> Settings -> Environment Variables.
#
# Use the POOLED connection string (its host contains "-pooler") for the serverless
# functions, so each invocation reuses a pooled connection instead of opening one
# per request. Keep sslmode=require.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"
